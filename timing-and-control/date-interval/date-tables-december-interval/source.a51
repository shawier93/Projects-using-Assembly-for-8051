
ORG 0H
MOV R7,#'B' ;CATEGORY 
MOV R6,#0; TO STORE THE TIME AT WHICH 
; THE USER SHOULD TAKE THE VACCINE 
; FROM 50H TO 53H REPRESENT THE RESULT PERIOD
MOV 50H,#0; DD
MOV 51H,#0; MM
MOV 52H,#0; YY 
MOV 53H,#0; YY 
; FROM 30H TO 33H REPRESENT THE CURRENT DATA
MOV 30H,#0; DD
MOV 31H,#0; MM
MOV 32H,#0; YY 
MOV 33H,#0; YY 
; FROM 40H TO 43H REPRESENT THE VACCINE DATA
MOV 40H,#0; DD
MOV 41H,#0; MM
MOV 42H,#0; YY 
MOV 43H,#0; YY 

START:
ACALL ReadDATE
ACALL ReadVdate

MOV A,R7 ; READ CATEGORY 
CJNE A,#'A',SECONDCAT
ACALL DURATION
ACALL CHECK

SECONDCAT:
CJNE A,#'B',WRONG
ACALL DURATION
ACALL CHECK

WRONG:
SJMP $

;------PRODURES-----
ReadDATE:
MOV DPTR,#CdatE
MOV R0,#30H
MOV R2,#4 ; COUNTER 
HERE1:
CLR A
MOVC A,@A+DPTR
MOV @R0,A
INC R0
INC DPTR
DJNZ R2,HERE1
RET
;*******************
ReadVdate:
MOV DPTR,#VdatE
MOV R0,#40H
MOV R2,#4 ; COUNTER 
HERE:
CLR A
MOVC A,@A+DPTR
MOV @R0,A
INC R0
INC DPTR
DJNZ R2,HERE
RET
;*******************
DURATION:
;DAYS
MOV R6,#0 ; BORROW
MOV A,30H
SUBB A,40H
JNC SAVE
ADD A,#30
MOV R6,#1
SAVE:
MOV 60H,A
;MONTHS
CLR C
MOV R5,#0
MOV A,31H
SUBB A,R6
SUBB A,41H
JNC SAVE1
ADD A,#12
MOV R5,#1
SAVE1:
MOV 61H,A
;YEARS
CLR C
MOV A,32H
SUBB A,R5
SUBB A,42H
MOV 62H,A
;YEARS
MOV A,33H
SUBB A,43H
MOV 63H,A
ACALL RESULT
RET
;*******************
RESULT:
; TO SAVE RESULTS AS BCD
MOV A,60H
MOV B,#10
DIV AB
MOV R3,B
MOV B,#16
MUL AB
ADD A,R3
MOV 50H,A
;; MONTHS
MOV A,61H
MOV B,#10
DIV AB
MOV R3,B
MOV B,#16
MUL AB
ADD A,R3
MOV 51H,A
;; YEARS
MOV A,62H
MOV B,#10
DIV AB
MOV R3,B
MOV B,#16
MUL AB
ADD A,R3
MOV 52H,A
;; YEARS
MOV A,63H
MOV B,#10
DIV AB
MOV R3,B
MOV B,#16
MUL AB
ADD A,R3
MOV 53H,A
RET
;*******************
CHECK:
MOV A,R7
CJNE A,#'A',CATB
MOV A,62H ; YEARS
CJNE A,#1,NEXTT
NEXTT: ;A>=1
JNC ASAP
;CheckMonths
CJNE A,#1,NEXTT2
NEXTT2:
JNC ASAP
MOV R6,#0H ;AFTER ZERO MOTHS
SJMP BACK

CATB:
MOV A,62H ; YEARS
CJNE A,#1,NEXTT1
NEXTT1: ;A>=1
JNC ASAP
;CheckMonths
CJNE A,#6,NEXTT22
NEXTT22:
JNC ASAP
CLR C
MOV A,#6
SUBB A,61H
MOV R6,A ;AFTER ZERO MOTHS
SJMP BACK

ASAP:
MOV R6,#0FFH; ASAP
BACK:
RET
;*******************


ORG 200H
      Cdate: db 10,12,21,20
      Vdate: db 7,8,21,20
END
