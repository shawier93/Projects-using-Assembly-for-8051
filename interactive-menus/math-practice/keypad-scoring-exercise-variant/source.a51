; Personal details removed.
; Personal details removed.

EN EQU P0.2
RS EQU P0.0
RW EQU P0.1
G 	BIT	    P1.0		
R	BIT	    P1.3

	
ORG 0
ACALL INLCD
;INITIALIZE SCORE, FAILS AND QUESTION COUNTER
	MOV	34H,#1		;QUESTION COUNTER=1
	MOV	35H,#0		;SCORE=0
	MOV	36H,#0		;FAILS=0
ACALL WELCOME
	MOV	DPTR,#QS
    MOV R2,#0
AGAIN:
   	MOV	DPTR,#QS
	CLR	A
    ADD A,R2
	MOVC A,@A+DPTR	;OPERATION
	MOV	R1,A
	INC	DPTR
    
	CLR	A
    ADD A,R2
	MOVC A,@A+DPTR	;NUMBER 1
	MOV	R3,A
	INC	DPTR
	CLR	A
    ADD A,R2
	MOVC A,@A+DPTR	;NUMBER 2
	MOV	R4,A
	INC	DPTR
	CLR	A
    ADD A,R2
	MOVC A,@A+DPTR	;CORRECT ANSWER
	MOV	R5,A
	INC	DPTR
	CLR	A
	ADD A,R2
	MOVC A,@A+DPTR	;SCORE
	INC	DPTR
	MOV	R6,A

    MOV A,R2
	ADD A,#5
	MOV R2,A
    
MOV 77H,R1
USER:
ACALL QUESTION

MOV R1,77H
	CJNE R1,#'+',NPL
;ADDITION PART
;READ USER ANSWER
	MOV	37H,#7
    ACALL ANS
	MOV	30H,R5
	MOV	A,30H
	MOV	B,37H
	CJNE A,B,WRONG
   	MOV	A,35H
	ADD	A,R6
	MOV	35H,A
	INC	34H
    ACALL RIGHT
  	SJMP AGAIN

NPL:
	CJNE R1,#'-',NMS
;SUBTRACTION PART
;READ USER ANSWER

	MOV	37H,#4
    ACALL ANS
	MOV	31H,R5
	MOV	A,31H
	MOV	B,37H
	CJNE A,B,WRONG
	MOV	A,35H
	ADD	A,R6
	MOV	35H,A
	INC	34H
    ACALL RIGHT
	SJMP AGAIN


NMS:
	CJNE R1,#'*',DVS
;MULTIPLICATION PART
;READ USER ANSWER
	MOV	37H,#12
ACALL ANS

	MOV	32H,R5
	MOV	A,32H
	MOV	B,37H
	CJNE A,B,WRONG
	MOV	A,35H
	ADD	A,R6
	MOV	35H,A
	INC	34H
    ACALL RIGHT
	SJMP AGAIN


DVS:
;DIVISION PART
;READ USER ANSWER
	MOV	37H,#6
ACALL ANS

	MOV	33H,R5
	MOV	A,33H
	MOV	B,37H
	CJNE A,B,WRONG
	MOV	A,35H
	ADD	A,R6
	MOV	35H,A
    ACALL RIGHT
	SJMP STOP

WRONG:
ACALL WRONGG
	INC	36H
	DEC	35H
	SJMP USER


STOP:
ACALL SCORE
ACALL BYE
	SJMP $
;%%%%%%%%%%
;%%%%%%%%%%
WELCOME:
MOV A, #80H 
ACALL CMD
MOV DPTR, #STR1
ACALL WSTR

MOV A,#90H
ACALL CMD
MOV DPTR, #STR2
ACALL WSTR
ACALL DELAY
RET

QUESTION:
ACALL DELAY
ACALL CLEAR
MOV A, #80H ;  
ACALL CMD
MOV A,R3  ; number1
MOV B,#10
DIV AB
ADD A,#30H
ACALL WCHR
MOV A,B
ADD A,#30H
ACALL WCHR


MOV R1,77H
MOV A,R1  ; operation
ACALL WCHR

MOV A,R4 ; number2 
ADD A,#30H
ACALL WCHR

RET

ANS:
MOV A,#90H
ACALL CMD
MOV A,37H
MOV B,#10
DIV AB
ADD A,#30H
ACALL WCHR
MOV A,B
ADD A,#30H
ACALL WCHR
ACALL DELAY
RET

WRONGG:
MOV A,#90H
ACALL CMD
MOV DPTR, #WRONG1
ACALL WSTR
ACALL DELAY
CLR R
MOV R7,#185
X1: 
ACALL LDELAY
DJNZ R7,X1
 MOV R7,#185
X2:
ACALL LDELAY
DJNZ R7,X2
SETB R
RET

FLASH:
CLR G
MOV R7,#185
Y11: 
ACALL LDELAY
DJNZ R7,Y11
 
MOV R7,#185
Y22:
ACALL LDELAY
DJNZ R7,Y22
SETB G
RET

RIGHT:
ACALL CLEAR
ACALL DELAY
MOV A, #80H 
ACALL CMD
MOV DPTR, #CORRECTT
ACALL WSTR

MOV A,#90H
ACALL CMD
MOV DPTR, #SCOREE
ACALL WSTR
MOV A,35H
ADD A,#30H
ACALL WCHR
ACALL DELAY
ACALL CLEAR
ACALL DELAY

ACALL FLASH
RET

SCORE:
MOV A, #80H 
ACALL CMD
MOV DPTR, #SCOREE
ACALL WSTR
MOV A,35H
MOV B,#10
DIV AB
ADD A,#30H
ACALL WCHR
MOV A,B
ADD A,#30H
ACALL WCHR

ACALL DELAY
MOV A,#90H
ACALL CMD
MOV DPTR, #FAIL
ACALL WSTR
MOV A,36H
ADD A,#30H
ACALL WCHR
ACALL DELAY
RET

BYE:
ACALL CLEAR 
ACALL DELAY
MOV A, #80H 
ACALL CMD
MOV DPTR, #OVERR
ACALL WSTR

MOV A,#90H
ACALL CMD
MOV DPTR, #THANKS
ACALL WSTR
ACALL DELAY
RET
;---------------
;---------------
DELAY:
MOV R1,#100
HE2: MOV R0,#10
HE:DJNZ R0,HE
DJNZ R1,HE2
RET
;;;;;;

INLCD:
 PUSH 7
 MOV R7,#20
WAIT:
 ACALL LDELAY ; STEP 1
 DJNZ R7,WAIT

 MOV P0,#00000111B ; INITIALISE 3 CONTROL SIGNALS=1
 MOV A,#0011B ; STEP 2
 ACALL CMD
 ACALL LDELAY ; STEP 3
 MOV A,#0011B ; STEP 4
 ACALL CMD
 MOV A,#0011B ; STEP 5
 ACALL CMD
 MOV A,#0010B ; STEP 6
 ACALL CMD
 MOV A,#0010B ; STEP 7 – SEND HIGH NIBBLE
 ACALL CMD
 MOV A,#1000B ; SEND LOW NIBBLE
 ACALL CMD
 MOV A,#0000B ; STEP 8 – TURN OFF DISPLAY – SEND HIGH NIBBLE
 ACALL CMD
 MOV A,#1000B ; SEND LOW NIBBLE
 ACALL CMD
 MOV A,#0 ; STEP 9 - CLEAR DISPLAY – SEND HIGH NIBBLE
 ACALL CMD
 MOV A,#0001B ; SEND LOW NIBBLE
 ACALL CMD
 ACALL LDELAY ; 4.1 MSEC REQUIRED FOR THIS COMMAND
 MOV A,#0000B ; STEP 10 - SET CURSOR MOVE RIGHT- SEND HIGH NIBBLE
 ACALL CMD
 MOV A,#0110B ; SEND LOW NIBBLE
 ACALL CMD
 MOV A,#0000B ; STEP 11 –SEND HIGH NIBBLE
 ACALL CMD ; TURN ON DISPLAY, CURSOR ON, BLINK CURSOR
 MOV A,#1111B ; SEND LOW NIBBLE
 ACALL CMD

 POP 7
 RET
;--- END OF LCD INITIALIZATION -----
;---- SUBROUTINE TO WRITE COMMAND IN A TO THE LCD -------
CMD:
 PUSH ACC
 PUSH B
 CLR RS ; RS = 0 COMMAND WRITE
MOV B,A

 SWAP A ; MOVE HIGHER NIBBLE TO LOWER NIBBLE
 ACALL COMMON ; WRITE OPERATION
 MOV A,B
ACALL COMMON

 POP B
 POP ACC
 RET
;---- SUBROUTINE TO WRITE CHARACTER IN A TO THE LCD -------
WCHR:
 PUSH ACC
 PUSH B
 SETB RS ; RS = 1 DATA WRITE
 MOV B,A

 SWAP A ; MOVE HIGHER NIBBLE TO LOWER NIBBLE
 ACALL COMMON ; WRITE OPERATION
MOV A,B
 ACALL COMMON

 POP B
 POP ACC
 RET
;----- COMMON OPERATION FOR CHAR WRITE AND COMMAND WRITE
COMMON:
 CLR RW
 SWAP A ; MOVE LOWER NIBBLE TO HIGHER NIBBLE
 ANL A,#11110000B
 ANL P0,#00000111B
 ORL P0,A
 SETB EN
 CLR EN
 ACALL LDELAY
 RET
;---- SUBROUTINE TO WRITE A STRING CHARACTER BY CHARACTER -------
WSTR:
 PUSH ACC
CONT1:
 CLR A
 MOVC A,@A+DPTR ; MOVE CHARACTER TO A
 JZ EXIT1
 ACALL WCHR ; CALL PROCEDURE TO WRITE A CHAR
 INC DPTR ; GET NEXT CHARACTER
 AJMP CONT1 ; GO TO CONT1
EXIT1:
 POP ACC ; RESTORE A
 RET
 ;------------ ˜ 5.4MSEC DELAY -------------------------------------------
LDELAY:
PUSH 0
PUSH 1 ; SAVE REGISTER1.
MOV R1,#20 ; MOVE 12 TO REGISTER R1
CON4:
MOV R0,#250
DJNZ R0,$
DJNZ R1,CON4 ; DECREASE R1, IF R1 !=0, GO TO CON4
POP 1
POP 0
RET


CLEAR:
MOV A,#01H
ACALL CMD
MOV R7,#17
WAITT: ACALL LDELAY
DJNZ R7,WAITT
RET 



QS:	DB	'+',5,2,7,1
	DB	'-',5,1,4,2
	DB	'*',2,6,12,3
	DB	'/',12,2,6,4

STR1: DB 'KUNIV MATH TESTER',0
STR2: DB 'ARE YOU READY',0
WRONG1: DB 'WRONG! TRY AGAIN',0
CORRECTT: DB 'CORRECT! ',0
SCOREE: DB 'YOUR SCORE:  ',0
FAIL: DB 'FIALS: ',0
OVERR: DB 'GAME IS OVER ',0
THANKS: DB 'THENAK YOU  ',0

	END























