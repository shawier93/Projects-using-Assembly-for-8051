LDATA EQU P0 
EN  EQU   	P0.2          
RS 	EQU   	P0.0           
RW 	EQU   	P0.1
G 	BIT	    P1.0		
Y 	BIT 	P1.1
R	BIT	    P1.3

ORG 00H 
ACALL INLCD

MOV 70H,#1; SELETCTION 
MOV R1,#23H
MOV 20H,#4 ; FIRST NUMBER
MOV 21H,#2 ;SECOND NUMBER
MOV 22H,#3 ;3RD NUMBER
MOV 30H,#6 ; NTH NUMBER
ACALL WELCOME

START:

ACALL SELECTT
MOV A,70H
CJNE A,#1,OPTION2
ACALL OPTIONN1
ACALL ENTER3NUMBER
MOV A,#6; NUMBER OF ELEMENTS
ACALL PERRINSEQ
ACALL PRINT1
SJMP START

OPTION2:
CJNE A,#2,OPTION3
ACALL OPTIONN2
ACALL ENTER3NUMBER
ACALL NthNumber
ACALL PRINT2
SJMP START

OPTION3:
CJNE A,#2,WRONG
SJMP EXIT

WRONG:
ACALL WRONGG
SJMP START

EXIT:
SJMP $


PERRINSEQ:
MOV R7,A
MOV R0,#22H
ST:
INC R0
MOV A,R0
DEC R0
DEC R0
MOV A,@R0
DEC R0 
ADD A,@R0
MOV R3,A
MOV A,R0
ADD A,#3
MOV R0,A
MOV A,R3
MOV @R0,A
DJNZ R7,ST
RET

NthNumber:
MOV A,30H
SUBB A,#3
ACALL PERRINSEQ
MOV 31H,R3
RET
