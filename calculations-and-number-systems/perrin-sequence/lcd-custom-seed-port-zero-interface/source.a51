PRINT1:
ACALL DELAY
ACALL CLEAR
MOV A, #8H  
ACALL CMD
MOV A, #0H  
ACALL CMD
ACALL LDELAY
MOV R4,#4
MOV R1,#20h
HH:
MOV A,@R1
MOV B,#10
DIV AB
ADD A,#30H
ACALL WCHR
MOV A,B
ADD A,#30H
ACALL WCHR
MOV A,#'-'
ACALL WCHR
INC R1
DJNZ R4,HH

MOV A, #1100B  
ACALL CMD
MOV A, #0H 
ACALL CMD
ACALL LDELAY
MOV R4,#4
HHH:
MOV A,@R1
MOV B,#10
DIV AB
ADD A,#30H
ACALL WCHR
MOV A,B
ADD A,#30H
ACALL WCHR
MOV A,#'-'
ACALL WCHR
