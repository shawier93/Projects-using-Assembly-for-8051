LDATA EQU P0 
EN  EQU   	P0.2          
RS 	EQU   	P0.0           
RW 	EQU   	P0.1
G 	BIT	    P1.0		
Y 	BIT 	P1.1
R	BIT	    P1.3

ORG 00H 
ACALL INLCD

MOV 30H, #1 ;OPERATION 1 OR2
MOV 40H, #3 ;BASE
MOV 41H, #4 ;HIGHT
MOV 42H, #2 ;SIDE A
MOV 43H, #3 ;SIDE B
MOV 44H, #4 ;SIDE C
MOV 50H, #0 ;RESULT
MOV 51H, #0 ; REMINDER
ACALL WELCOME

MENU:
;CHEACK OPERATION
ACALL Menuu
ACALL SELECTT
MOV A,30H
CJNE A,#1,OPERATION2
;OPERATION 1
ACALL OPTIONN1
ACALL ENTER_DIM
ACALL AREAA
ACALL PRINT1
SJMP CONTINUE

OPERATION2:
CJNE A,#2,WRONG
;OPERATION 2
ACALL OPTIONN2
ACALL ENTER_SIDES
ACALL PERIMETER
ACALL PRINT2
SJMP CONTINUE

WRONG:
ACALL WRONGG
SJMP MENU

EXIT:
ACALL CLEAR
ACALL DELAY
MOV A, #8H  
ACALL CMD
MOV A, #0H  
ACALL CMD
mov dptr, #THANKS
acall wstr
EE:SJMP EE


AREAA:
;COPY THE BASE AND HIGHT
MOV A,40H
MOV B,41H
; PEFORM THE MULTIPLAICATION FIRS
MUL AB
;THEN DIVIDE HTE RESULT SAVED IN A BY 2
MOV B,#2
DIV AB
MOV 50H,A
MOV 51H,B
RET

PERIMETER:
;SIDE a
MOV A,42H
;ADD SIDE a AND SIDE b
ADD A,43H
; ADD SIDE c TO THE RESULT
ADD A,44H
;SAVE THE RESULT
MOV 50H,A
RET

CONTINUE:
ACALL CON
MOV A,#2
CJNE A,#1,EXIT
SJMP MENU
RET
;----------------
;---------------
welcome:
