acall wstr

MOV A, #1100B  
ACALL CMD
MOV A, #0H 
ACALL CMD
mov dptr, #SIDEA
acall wstr
MOV A,42H
ADD A,#30H
ACALL WCHR
mov dptr, #SIDEB
acall wstr
MOV A,43H
ADD A,#30H
ACALL WCHR
mov dptr, #SIDEC
acall wstr
MOV A,44H
ADD A,#30H
ACALL WCHR
ACALL DELAY
RET


ENTER_DIM:
ACALL CLEAR
ACALL DELAY
MOV A, #8H  
ACALL CMD
MOV A, #0H  
ACALL CMD
mov dptr, #ENTERSIDES
acall wstr
MOV A, #1100B  
ACALL CMD
MOV A, #0H 
ACALL CMD
mov dptr, #SIDEB
acall wstr
MOV A,40H
ADD A,#30H
ACALL WCHR
mov dptr, #HIGHT
acall wstr
MOV A,41H
ADD A,#30H
ACALL WCHR
ACALL DELAY
RET

CON:
ACALL CLEAR
ACALL DELAY
MOV A, #8H  
ACALL CMD
MOV A, #0H  
ACALL CMD
mov dptr, #CONT11
acall wstr
MOV A, #1100B  
ACALL CMD
MOV A, #0H 
ACALL CMD
mov dptr, #CONT22
acall wstr
RET

PRINT1:
ACALL CLEAR
ACALL DELAY
MOV A, #8H  
ACALL CMD
MOV A, #0H  
ACALL CMD
mov dptr, #AAREA
acall wstr
MOV A,50H
MOV B,#10
DIV AB
ADD A,#30H
ACALL WCHR
MOV A,B
ADD A,#30H
ACALL WCHR
ACALL LDELAY

MOV A, #1100B  
ACALL CMD
MOV A, #0H 
ACALL CMD
mov dptr, #REMINDER
acall wstr
MOV A,51H
ADD A,#30H
ACALL WCHR

ACALL DELAY

RET

PRINT2:
