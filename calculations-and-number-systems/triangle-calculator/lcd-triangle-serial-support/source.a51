MSG: db 'SELECTION: ',0
MSG1: db 'you chose Area',0
MSG2: db 'you chose PERIMETER',0
WRONGGG: db 'WRONG !! ',0
ENTERSIDES: db 'ENTER SIDES: ',0
SIDEA: db 'a=',0
SIDEB: db '  b=',0
SIDEC: db '  c=',0
HIGHT: db '  h=',0
AAREA: db 'AREA =  ',0
PPERIMETER: db 'PERIMETER =  ',0
REMINDER: db 'REMINDER= ',0
CONT11: db 'WANT TO CONTINUE? ',0
CONT22: db '1-YES 2-NO ',0
THANKS: db '---THANK YOU--- ',0


