;---------------
;----- 1ST PROCEDURE -----
INIT:
	MOV A,PCON 
	CLR ACC.7
	MOV PCON,A
	MOV SCON,#50H 
	MOV TMOD,#21H
	MOV TH1,#-3           
	SETB TR1 
	RET
;----- END 1ST PROCEDURE -----

;----- 2ND PROCEDURE -----
INLCD:
	PUSH 7
	MOV R7,#20
WAIT:
	ACALL LDELAY 
	DJNZ R7,WAIT
	MOV P0,#00000111B 
	MOV A,#0011B 
	ACALL CMD
	ACALL LDELAY 
	MOV A,#0011B 
	ACALL CMD
	MOV A,#0011B 
	ACALL CMD
	MOV A,#0010B 
	ACALL CMD
	MOV A,#0010B 
	ACALL CMD
	MOV A,#1000B 
	ACALL CMD
	MOV A,#0000B 
	ACALL CMD
	MOV A,#1000B 
	ACALL CMD
	MOV A,#0 
	ACALL CMD
	MOV A,#0001B 
	ACALL CMD
	ACALL LDELAY 
	MOV A,#0000B 
	ACALL CMD
	MOV A,#0110B 
	ACALL CMD
	MOV A,#0000B 
	ACALL CMD 
	MOV A,#1111B 
	ACALL CMD
	POP 7
	RET
;----- END 2ND PROCEDURE -----

;----- 3RD PROCEDURE -----	
CMD:
	CLR RS 
	ACALL COMMON
	RET
;----- END 3RD PROCEDURE -----

;----- 4TH PROCEDURE -----	
WCHR:
	PUSH ACC
	PUSH B
	SETB RS 
	MOV B,A
	SWAP A 
	ACALL COMMON 
	MOV A,B
	ACALL COMMON
	POP B
	POP ACC
	RET
;----- END 4TH PROCEDURE -----

;----- 5TH PROCEDURE -----	
COMMON:
	CLR RW
	SWAP A 
	ANL A,#11110000B
	ANL P0,#00000111B
	ORL P0,A
	SETB EN
	CLR EN
	ACALL LDELAY
	RET
;----- END 5TH PROCEDURE -----

;----- 6TH PROCEDURE -----	
WSTR:
	PUSH ACC
CONT1: CLR A
	MOVC A,@A+DPTR 
	JZ EXIT1
	ACALL WCHR 
	;ACALL COUT
	INC DPTR 
	AJMP CONT1
EXIT1:
	POP ACC 
	RET
;----- END 6TH PROCEDURE -----

;----- 7TH PROCEDURE -----	
LDELAY:
	PUSH 0
	PUSH 1 
	MOV R1,#20
CON4: MOV R0,#250
	DJNZ R0,$
	DJNZ R1,CON4
	POP 1
	POP 0
	RET
;----- END 7TH PROCEDURE -----



;----- 9TH PROCEDURE -----
TMSEC:
        MOV TMOD,#21H
	MOV TL0,#0CAH 
	MOV TH0,#27H
	SETB TR0
BACK: 
	JNB TF0,BACK
	CLR TR0
	CLR TF0
	RET
;----- END 9TH PROCEDURE ---

CLEAR:  
MOV A,#0H
ACALL CMD
MOV A,#1H
ACALL CMD
ACALL LDELAY
MOV R7,#14
WAITT: ACALL LDELAY
DJNZ R7,WAITT
RET 

;; 5MS *60
DELAY:
MOV R5,#70
HH:
ACALL LDELAY
DJNZ R5,HH
RET


