; Personal details removed.
; Personal details removed.
LDATA EQU P0 
EN  EQU   	P0.2          
RS 	EQU   	P0.0           
RW 	EQU   	P0.1
G 	BIT	    P1.0		
Y 	BIT 	P1.1
R	BIT	    P1.3

ORG 0000H
LJMP MAIN

ORG 0003H ; EX0 interrupt vector address
LJMP EX0ISR

ORG 0030H
	
MAIN:
MOV 30H,#0 
MOV 40H,#0
MOV 41H,#0  
MOV 50H,#00 
MOV 51H,#00 
MOV 60H,#00

ACALL INLCD

ACALL DELAY
ACALL CLEAR
MOV A, #8H  
ACALL CMD
MOV A, #0H  
ACALL CMD
ACALL LDELAY

MOV DPTR, #STR1
ACALL WSTR
ACALL DELAY

MOV A, #1100B  
ACALL CMD
MOV A, #0H 
ACALL CMD
ACALL LDELAY
MOV DPTR, #STR2
ACALL WSTR
ACALL DELAY

MOV IE,#10000001B ;ENABLE EX0
SETB IT0
SJMP $
EX0ISR:
START:
ACALL MENU
SETB G
SETB Y
SETB R

ACALL KEYPAD
MOV 30H,A    
ACALL WCHR
ACALL DELAY

ACALL SELECTION
MOV A,30H
CJNE A,#'1',SUBTRACT
CLR G 
ACALL NUMBERS
MOV A,40H
ADD A,41H
MOV 50H,A
ACALL RESULTS
SETB G
SJMP NEXT


SUBTRACT:
CJNE A,#'2',MULTIPLICATION
CLR G 
ACALL NUMBERS
MOV A,40H
SUBB A,41H
MOV 50H,A
ACALL RESULTS
SETB G
SJMP NEXT

MULTIPLICATION:
CJNE A,#'3',DIVISION
CLR G 
ACALL NUMBERS
MOV A,40H
MOV B,41H
MUL AB
MOV 50H,A
ACALL RESULTS
SETB G
SJMP NEXT

DIVISION:
CJNE A,#'4',WRONG
CLR G 
ACALL NUMBERS
MOV A,40H
MOV B,41H
DIV AB
MOV 50H,A
MOV 51H,B
ACALL RESULTS
ACALL REMINDER
SETB G
SJMP NEXT

WRONG: 
CLR R
ACALL DELAY
ACALL CLEAR
ACALL DELAY
MOV A,#8H  
ACALL CMD
MOV A,#0H  
ACALL CMD
ACALL LDELAY

MOV DPTR, #STR10
ACALL WSTR
ACALL DELAY
SETB R
AJMP START


NEXT:
ACALL CONTINUE
MOV A,60H
ACALL KEYPAD
ACALL WCHR
ACALL DELAY
SUBB A,#30H
MOV 60H,A
CJNE A,#2,START1

ACALL CLEAR
MOV A,#8H  
ACALL CMD
MOV A,#0H  
ACALL CMD
ACALL LDELAY
MOV DPTR, #STR13
ACALL WSTR
ACALL DELAY

SJMP STOPP
START1:AJMP START
STOPP:
SJMP STOPP
RETI



;----- 1ST PROCEDURE -----


MENU:
ACALL CLEAR
ACALL DELAY
MOV A, #8H  
ACALL CMD
MOV A, #0H  
ACALL CMD
ACALL LDELAY
MOV DPTR, #STR3
ACALL WSTR
ACALL DELAY

MOV A, #1100B  
ACALL CMD
MOV A, #0H 
ACALL CMD
ACALL LDELAY
MOV DPTR, #STR4
ACALL WSTR
ACALL DELAY
RET
;;----- B PROCEDURE -----
SELECTION:
ACALL DELAY
ACALL CLEAR
MOV A, #8H  
ACALL CMD
MOV A, #0H  
ACALL CMD
ACALL LDELAY
ACALL DELAY
MOV DPTR, #STR5
ACALL WSTR
ACALL LDELAY
MOV A,30H

ACALL WCHR
ACALL DELAY
MOV A, #1100B  
ACALL CMD
MOV A, #0H 
ACALL CMD
ACALL LDELAY
MOV A,30H
CJNE A,#'1',SSUB
MOV DPTR, #STR14
SJMP NNEXT
SSUB:
CJNE A,#'2',MMUL
MOV DPTR, #STR15
SJMP NNEXT
MMUL:
CJNE A,#'3',DDIV
MOV DPTR, #STR16
SJMP NNEXT
DDIV:
CJNE A,#'4',NNNEXT
MOV DPTR, #STR17
SJMP NNEXT
NNEXT:
ACALL WSTR
ACALL DELAY
NNNEXT:
RET
;----------------------
NUMBERS:
ACALL DELAY
ACALL CLEAR
MOV A, #8H  
ACALL CMD
MOV A, #0H  
ACALL CMD
ACALL LDELAY
MOV DPTR, #STR6
ACALL WSTR
ACALL DELAY

ACALL KEYPAD
ACALL WCHR
SUBB A,#30H
MOV 40H,A
ACALL DELAY

MOV A, #1100B  
ACALL CMD
MOV A, #0H 
ACALL CMD
ACALL LDELAY
MOV DPTR, #STR7
ACALL WSTR
ACALL DELAY

ACALL KEYPAD
ACALL WCHR
SUBB A,#30H
MOV 41H,A
ACALL DELAY
RET
;-------------------------
RESULTS:
ACALL DELAY
ACALL CLEAR
MOV A, #8H  
ACALL CMD
MOV A, #0H  
ACALL CMD
ACALL LDELAY
MOV DPTR, #STR8
ACALL WSTR
ACALL DELAY
MOV A,50H     
MOV B,#10
DIV AB
ADD A,#30H
ACALL WCHR
MOV A,B
ADD A,#30H
ACALL WCHR
ACALL DELAY
RET
;-----
REMINDER:

MOV A, #1100B  
ACALL CMD
MOV A, #0H 
ACALL CMD
ACALL LDELAY
MOV DPTR, #STR9
ACALL WSTR
ACALL DELAY
MOV A,51H
ADD A,#30H
ACALL WCHR
ACALL DELAY
RET
;----
CONTINUE:
ACALL CLEAR
MOV A, #8H  
ACALL CMD
MOV A, #0H  
ACALL CMD
ACALL LDELAY
MOV DPTR, #STR11
ACALL WSTR
ACALL DELAY

MOV A, #1100B  
ACALL CMD
MOV A, #0H 
ACALL CMD
ACALL LDELAY
MOV DPTR, #STR12
ACALL WSTR
ACALL DELAY






RET
;**********************
;----- 1ST PROCEDURE -----
INIT:
	MOV A,PCON 
	CLR ACC.7
	MOV PCON,A
	MOV SCON,#50H 
	MOV TMOD,#21H
	MOV TH1,#-3           
	SETB TR1 
	RET
;----- END 1ST PROCEDURE -----

;----- 2ND PROCEDURE -----
INLCD:
	PUSH 7
	MOV R7,#20
WAIT:
	ACALL LDELAY 
	DJNZ R7,WAIT
	MOV P0,#00000111B 
	MOV A,#0011B 
	ACALL CMD
	ACALL LDELAY 
	MOV A,#0011B 
	ACALL CMD
	MOV A,#0011B 
	ACALL CMD
	MOV A,#0010B 
	ACALL CMD
	MOV A,#0010B 
	ACALL CMD
	MOV A,#1000B 
	ACALL CMD
	MOV A,#0000B 
	ACALL CMD
	MOV A,#1000B 
	ACALL CMD
	MOV A,#0 
	ACALL CMD
	MOV A,#0001B 
	ACALL CMD
	ACALL LDELAY 
	MOV A,#0000B 
	ACALL CMD
	MOV A,#0110B 
	ACALL CMD
	MOV A,#0000B 
	ACALL CMD 
	MOV A,#1111B 
	ACALL CMD
	POP 7
	RET
;----- END 2ND PROCEDURE -----

;----- 3RD PROCEDURE -----	
CMD:
	CLR RS 
	ACALL COMMON
	RET
;----- END 3RD PROCEDURE -----

;----- 4TH PROCEDURE -----	
WCHR:
	PUSH ACC
	PUSH B
	SETB RS 
	MOV B,A
	SWAP A 
	ACALL COMMON 
	MOV A,B
	ACALL COMMON
	POP B
	POP ACC
	RET
;----- END 4TH PROCEDURE -----

;----- 5TH PROCEDURE -----	
COMMON:
	CLR RW
	SWAP A 
	ANL A,#11110000B
	ANL P0,#00000111B
	ORL P0,A
	SETB EN
	CLR EN
	ACALL LDELAY
	RET
;----- END 5TH PROCEDURE -----

;----- 6TH PROCEDURE -----	
WSTR:
	PUSH ACC
CONT1: CLR A
	MOVC A,@A+DPTR 
	JZ EXIT1
	ACALL WCHR 
	;ACALL COUT
	INC DPTR 
	AJMP CONT1
EXIT1:
	POP ACC 
	RET
;----- END 6TH PROCEDURE -----

;----- 7TH PROCEDURE -----	
LDELAY:
	PUSH 0
	PUSH 1 
	MOV R1,#20
CON4: MOV R0,#250
	DJNZ R0,$
	DJNZ R1,CON4
	POP 1
	POP 0
	RET
;----- END 7TH PROCEDURE -----
;----- 8th Procedure -----
KEYPAD:
	MOV P2,#11110000B
K1: MOV P2,#11110000B 
	MOV A,P2 
	ANL A,#11110000B 
	CJNE A,#11110000B,K1 
K2: ACALL TMSEC
	MOV A,P2 
	ANL A,#11110000B 
	CJNE A,#11110000B,OVER 
	SJMP K2 
OVER:
	ACALL TMSEC
	MOV A,P2 
	ANL A,#11110000B 
	CJNE A,#11110000B,OVER1 
	SJMP K2 
OVER1:
	MOV P2,#11111110B 
	MOV A,P2 
	ANL A,#11110000B 
	CJNE A,#11110000B,ROW_0 
	MOV P2,#11111101B 
	MOV A,P2 
	ANL A,#11110000B 
	CJNE A,#11110000B,ROW_1 
	MOV P2,#11111011B 
	MOV A,P2 
	ANL A,#11110000B 
	CJNE A,#11110000B,ROW_2 
	MOV P2,#11110111B 
	MOV A,P2 
	ANL A,#11110000B 
	CJNE A,#11110000B,ROW_3 
	LJMP K2 
ROW_0: MOV DPTR,#KCODE0 
	SJMP FIND 
ROW_1: MOV DPTR,#KCODE1 
	SJMP FIND 
ROW_2: MOV DPTR,#KCODE2 
	SJMP FIND 
ROW_3: MOV DPTR,#KCODE3 
FIND:
	SWAP A 
FIND1:
	RRC A 
	JNC MATCH 
	INC DPTR
	SJMP FIND1 
MATCH:
	CLR A 
	MOVC A,@A+DPTR 
	RET
;----- end 8th Procedure -----

;----- 9TH PROCEDURE -----
TMSEC:
        MOV TMOD,#21H
	MOV TL0,#0CAH 
	MOV TH0,#27H
	SETB TR0
BACK: 
	JNB TF0,BACK
	CLR TR0
	CLR TF0
	RET
;----- END 9TH PROCEDURE ---

CLEAR:  
MOV A,#0H
ACALL CMD
MOV A,#1H
ACALL CMD
ACALL LDELAY
MOV R7,#14
WAITT: ACALL LDELAY
DJNZ R7,WAITT
RET 


DELAY:
MOV R5,#170
HH:
ACALL LDELAY
DJNZ R5,HH
RET

;*********************************

KCODE0: DB '1','2','3','A' ;Row0 
KCODE1: DB '4','5','6','B' ;Row1
KCODE2: DB '7','8','9','C' ;Row2
KCODE3: DB '*','0','#','D' ;Row3


STR1: DB 'WELCOME TO',0
STR2: DB 'CALCULATOR',0
STR3: DB '1.ADD   2.SUB',0
STR4: DB '3.MUL   4.DIV ',0
STR5: DB 'SELECTION: ',0
STR6: DB 'NUM1: ',0
STR7: DB 'NUM2: ',0
STR8: DB 'RESULT IS ',0
STR9: DB 'REMINDER IS  ',0
STR10: DB 'WRONG SELECTION!! ',0
STR11: DB 'WANT TO CONT? ',0
STR12: DB '1-YES 2-NO  : ',0
STR13: DB 'THANK YOU  ',0
STR14: DB 'YOU CHOSE ADD',0
STR15: DB 'YOU CHOSE SUB',0
STR16: DB 'YOU CHOSE MUL',0
STR17: DB 'YOU CHOSE DIV',0


END
