LDATA EQU P0 
EN  EQU   	P0.2          
RS 	EQU   	P0.0           
RW 	EQU   	P0.1
G 	BIT	    P1.0		
Y 	BIT 	P1.1
R	BIT	    P1.3

ORG 00H

ACALL INLCD
MOV 30H,#2 ; SELECTED OPERATION
; 1 --> SUM
; 2--> SUB
; 3--> MUL
; 4--> DIV
MOV 40H,#6
MOV 41H,#3   
MOV 50H,#00 ; RESULT
MOV 51H,#00 ; REMINDER
MOV 60H,#02 ; YES OR NO
ACALL FLASHING

ACALL INLCD

ACALL DELAY
ACALL CLEAR
MOV A, #8H ; 
ACALL CMD
MOV A, #0H ; 
ACALL CMD
ACALL LDELAY

MOV DPTR, #STR1
ACALL WSTR
ACALL DELAY

MOV A, #1100B ;   
ACALL CMD
MOV A, #0H ; 
ACALL CMD
ACALL LDELAY
MOV DPTR, #STR2
ACALL WSTR
ACALL DELAY


START:
ACALL MENU
SETB G
SETB Y
SETB R

ACALL SELECTION
MOV A,30H
CJNE A,#1,SUBTRACT
CLR G ; GREEN LED
ACALL NUMBERS
MOV A,40H
ADD A,41H
MOV 50H,A
ACALL RESULTS
SJMP NEXT


SUBTRACT:
CJNE A,#2,MULTIPLICATION
CLR Y ; YELLOW LED
ACALL NUMBERS
MOV A,40H
SUBB A,41H
MOV 50H,A
ACALL RESULTS
SJMP NEXT

MULTIPLICATION:
CJNE A,#3,DIVISION
CLR R ; RED LED
ACALL NUMBERS
MOV A,40H
MOV B,41H
MUL AB
MOV 50H,A
ACALL RESULTS

SJMP NEXT

DIVISION:
CJNE A,#4,WRONG
CLR G ; GREEN LED
CLR Y ; YELLOW LED
ACALL NUMBERS
MOV A,40H
MOV B,41H
DIV AB
MOV 50H,A
MOV 51H,B
ACALL RESULTS
ACALL REMINDER
SJMP NEXT

WRONG: 
ACALL CLEAR
ACALL DELAY
MOV A, #8H ; 
ACALL CMD
MOV A, #0H ; 
ACALL CMD
ACALL LDELAY

MOV DPTR, #STR10
ACALL WSTR
ACALL DELAY
SJMP START


NEXT:
ACALL CONTINUE
MOV A,60H
CJNE A,#2,START
;; THANK YOU
ACALL CLEAR
MOV A, #8H ; 
ACALL CMD
MOV A, #0H ; 
ACALL CMD
ACALL LDELAY
MOV DPTR, #STR13
ACALL WSTR
ACALL DELAY

STOPP:
SJMP STOPP


;----- 1ST PROCEDURE -----
FLASHING:
MOV R3,#3
HERE:
CLR G
ACALL DELAY
SETB G
ACALL DELAY
DJNZ R3,HERE
RET
;--------

MENU:
ACALL CLEAR
ACALL DELAY
MOV A, #8H ; 
ACALL CMD
MOV A, #0H ; 
ACALL CMD
ACALL LDELAY
MOV DPTR, #STR3
ACALL WSTR
ACALL DELAY

MOV A, #1100B ; 
ACALL CMD
MOV A, #0H ; 
ACALL CMD
ACALL LDELAY
MOV DPTR, #STR4
ACALL WSTR
ACALL DELAY
RET
;;----- B PROCEDURE -----
SELECTION:
ACALL DELAY
ACALL CLEAR
MOV A, #8H ; 
ACALL CMD
MOV A, #0H ; 
ACALL CMD
ACALL LDELAY
ACALL DELAY
MOV DPTR, #STR5
ACALL WSTR
ACALL LDELAY
MOV A,30H
ADD A,#30H
ACALL WCHR
ACALL DELAY
RET
;----------------------
NUMBERS:
ACALL DELAY
ACALL CLEAR
MOV A, #8H ; 
ACALL CMD
MOV A, #0H ; 
ACALL CMD
ACALL LDELAY
MOV DPTR, #STR6
ACALL WSTR
ACALL DELAY
MOV A,40H
ADD A,#30H
ACALL WCHR
ACALL DELAY

MOV A, #1100B ; 
ACALL CMD
MOV A, #0H ; 
ACALL CMD
ACALL LDELAY
MOV DPTR, #STR7
ACALL WSTR
ACALL DELAY
MOV A,41H
ADD A,#30H
ACALL WCHR
ACALL DELAY
RET
;-------------------------
RESULTS:
ACALL DELAY
ACALL CLEAR
MOV A, #8H ; 
ACALL CMD
MOV A, #0H ; 
ACALL CMD
ACALL LDELAY
MOV DPTR, #STR8
ACALL WSTR
ACALL DELAY
MOV A,50H     ;  18/10 = 1.8   1   8
MOV B,#10
DIV AB
ADD A,#30H
ACALL WCHR
MOV A,B
ADD A,#30H
ACALL WCHR
ACALL DELAY
RET
;-----
REMINDER:

MOV A, #1100B ; 
ACALL CMD
MOV A, #0H ; 
ACALL CMD
ACALL LDELAY
MOV DPTR, #STR9
ACALL WSTR
ACALL DELAY
MOV A,51H
ADD A,#30H
ACALL WCHR
ACALL DELAY
RET
;----
CONTINUE:
ACALL CLEAR
MOV A, #8H ; 
ACALL CMD
MOV A, #0H ; 
ACALL CMD
ACALL LDELAY
MOV DPTR, #STR11
ACALL WSTR
ACALL DELAY

MOV A, #1100B ; 
ACALL CMD
MOV A, #0H ; 
ACALL CMD
ACALL LDELAY
MOV DPTR, #STR12
ACALL WSTR
ACALL DELAY

MOV A,60H
ADD A,#30H
ACALL WCHR
ACALL DELAY




RET
;**********************
;----- 1ST PROCEDURE -----
INIT:
	MOV A,PCON 
	CLR ACC.7
	MOV PCON,A
	MOV SCON,#50H 
	MOV TMOD,#21H
	MOV TH1,#-3           
	SETB TR1 
	RET
;----- END 1ST PROCEDURE -----

;----- 2ND PROCEDURE -----
INLCD:
	PUSH 7
	MOV R7,#20
WAIT:
	ACALL LDELAY 
	DJNZ R7,WAIT
	MOV P0,#00000111B 
	MOV A,#0011B 
	ACALL CMD
	ACALL LDELAY 
	MOV A,#0011B 
	ACALL CMD
	MOV A,#0011B 
	ACALL CMD
	MOV A,#0010B 
	ACALL CMD
	MOV A,#0010B 
	ACALL CMD
	MOV A,#1000B 
	ACALL CMD
	MOV A,#0000B 
	ACALL CMD
	MOV A,#1000B 
	ACALL CMD
	MOV A,#0 
	ACALL CMD
	MOV A,#0001B 
	ACALL CMD
	ACALL LDELAY 
	MOV A,#0000B 
	ACALL CMD
	MOV A,#0110B 
	ACALL CMD
	MOV A,#0000B 
	ACALL CMD 
	MOV A,#1111B 
	ACALL CMD
	POP 7
	RET
;----- END 2ND PROCEDURE -----

;----- 3RD PROCEDURE -----	
CMD:
	CLR RS 
	ACALL COMMON
	RET
;----- END 3RD PROCEDURE -----

;----- 4TH PROCEDURE -----	
WCHR:
	PUSH ACC
	PUSH B
	SETB RS 
	MOV B,A
	SWAP A 
	ACALL COMMON 
	MOV A,B
	ACALL COMMON
	POP B
	POP ACC
	RET
;----- END 4TH PROCEDURE -----

;----- 5TH PROCEDURE -----	
COMMON:
	CLR RW
	SWAP A 
	ANL A,#11110000B
	ANL P0,#00000111B
	ORL P0,A
	SETB EN
	CLR EN
	ACALL LDELAY
	RET
;----- END 5TH PROCEDURE -----

;----- 6TH PROCEDURE -----	
WSTR:
	PUSH ACC
CONT1: CLR A
	MOVC A,@A+DPTR 
	JZ EXIT1
	ACALL WCHR 
	;ACALL COUT
	INC DPTR 
	AJMP CONT1
EXIT1:
	POP ACC 
	RET
;----- END 6TH PROCEDURE -----

;----- 7TH PROCEDURE -----	
LDELAY:
	PUSH 0
	PUSH 1 
	MOV R1,#20
CON4: MOV R0,#250
	DJNZ R0,$
	DJNZ R1,CON4
	POP 1
	POP 0
	RET
;----- END 7TH PROCEDURE -----



;----- 9TH PROCEDURE -----
TMSEC:
        MOV TMOD,#21H
	MOV TL0,#0CAH 
	MOV TH0,#27H
	SETB TR0
BACK: 
	JNB TF0,BACK
	CLR TR0
	CLR TF0
	RET
;----- END 9TH PROCEDURE ---

CLEAR:  
MOV A,#0H
ACALL CMD
MOV A,#1H
ACALL CMD
ACALL LDELAY
MOV R7,#14
WAITT: ACALL LDELAY
DJNZ R7,WAITT
RET 

;; 5MS *60
DELAY:
MOV R5,#60
HH:
ACALL LDELAY
DJNZ R5,HH
RET


;*********************************




STR1: DB 'WELCOME TO',0
STR2: DB 'CALCULATOR',0
STR3: DB '1.ADD   2.SUB',0
STR4: DB '3.MUL   4.DIV ',0
STR5: DB 'SELECTION: ',0
STR6: DB 'NUM1: ',0
STR7: DB 'NUM2: ',0
STR8: DB 'RESULT IS ',0
STR9: DB 'REMINDER IS  ',0
STR10: DB 'WRONG SELECTION!! ',0
STR11: DB 'WANT TO CONT? ',0
STR12: DB '1-YES 2-NO  : ',0
STR13: DB 'THANK YOU  ',0


END
